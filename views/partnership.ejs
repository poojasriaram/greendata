<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
  <!-- Page Hero -->
  <section class="page-hero-section">
    <div class="container">
      <div class="page-hero-content">
        <div class="badge badge-accent">Institutional Co-Development</div>
        <h1 class="page-title">Joint Venture &amp; Capital Partnerships</h1>
        <p class="page-lead">
          Strategic frameworks for Sovereign Wealth Funds, Global Private Equity, Institutional REITs, and Prime Master Landowners across South India.
        </p>
      </div>
    </div>
  </section>

  <!-- JV Models -->
  <section class="section-padded bg-surface">
    <div class="container">
      <div class="section-header-block">
        <div class="badge badge-primary">Institutional Alignment</div>
        <h2 class="section-heading">Disciplined Governance &amp; High-Yield Co-Investment</h2>
        <p class="section-subtext">GreenNext operates with transparent corporate governance, single-purpose development SPVs, and institutional reporting standards.</p>
      </div>

      <div class="jv-cards-grid">
        <div class="jv-card">
          <div class="jv-icon">🏛️</div>
          <h3 class="jv-card-title">Institutional Equity Platform JV</h3>
          <p class="jv-card-desc">For global private equity and sovereign infrastructure funds looking to deploy growth capital into high-yield South Indian digital and commercial infrastructure assets.</p>
          <ul class="jv-feature-list">
            <li>Dedicated Single-Asset or Multi-Asset Platform SPVs</li>
            <li>Board representation and veto rights on major capital outlays</li>
            <li>Target Net IRR hurdles: 18% – 24% with strong downside land backing</li>
          </ul>
        </div>

        <div class="jv-card">
          <div class="jv-icon">🗺️</div>
          <h3 class="jv-card-title">Strategic Landowner Joint Development (JD)</h3>
          <p class="jv-card-desc">For owners of contiguous 25+ acre land parcels across South India seeking maximum asset monetization through institutional master development.</p>
          <ul class="jv-feature-list">
            <li>Revenue-share or built-area share structures with bank guarantees</li>
            <li>GreenNext funds 100% of approvals, development &amp; tenant leasing</li>
            <li>Zero litigation risk with thorough institutional title insurance</li>
          </ul>
        </div>
      </div>

      <!-- Partnership Contact Form Box -->
      <div class="jv-contact-box" style="margin-top: 60px;">
        <div class="badge badge-accent">Direct Private Equity Desk</div>
        <h3 style="font-size: var(--text-2xl); margin-top: 10px; color: var(--c-dark-text-primary);">Initiate Confidential Partnership Discussion</h3>
        <p style="color: var(--c-dark-text-secondary); max-width: 680px; margin-top: 8px;">
          Connect directly with our Managing Partners and Chief Investment Officer under institutional NDA.
        </p>
        <div style="margin-top: 20px; display:flex; gap:16px; flex-wrap:wrap;">
          <button class="btn btn-primary" data-open-modal="rfpModal" type="button">Submit Institutional JV Proposal</button>
          <a class="btn btn-outline-light" href="mailto:invest@greennext.in">Email: invest@greennext.in</a>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/floating-widget') %>
<%- include('partials/modal-rfp') %>
<%- include('partials/footer') %>

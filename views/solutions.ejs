<%- include('partials/head') %>
<%- include('partials/header') %>

<main id="main-content">
  <!-- Page Hero -->
  <section class="page-hero-section">
    <div class="container">
      <div class="page-hero-content">
        <div class="badge badge-accent">Enterprise Delivery Framework</div>
        <h1 class="page-title">Institutional Delivery Models &amp; Commercial Structures</h1>
        <p class="page-lead">
          From high-voltage powered shell hand-offs to turnkey build-to-suit campuses and long-term institutional leases across South India.
        </p>
      </div>
    </div>
  </section>

  <!-- Solutions Grid -->
  <section class="section-padded bg-surface">
    <div class="container">
      <div class="solutions-detail-list">
        <!-- Model 1: Powered Shell -->
        <div class="solution-detail-row">
          <div class="sol-content-col">
            <div class="badge badge-primary">Model 01</div>
            <h2 class="sol-detail-title">Powered Shell Delivery</h2>
            <p class="sol-detail-lead">Ultra-fast time-to-market for cloud hyperscalers, global OTT platforms, and large AI model training operators.</p>
            <p class="sol-detail-body">
              GreenNext delivers energized, high-voltage GIS substations (up to 400kV), hardened external building structures with heavy floor loading (>2,500 kg/sq.m.), dual underground fiber entry vaults, and security compound fencing. Occupiers deploy their own proprietary MEP, chillers, and server architecture.
            </p>
            <ul class="sol-feature-list">
              <li>&check; Substation energized and pre-commissioned prior to tenant handover</li>
              <li>&check; 12 to 18 month acceleration vs greenfield development</li>
              <li>&check; Direct long-term open access green energy PPA integration</li>
            </ul>
            <button class="btn btn-primary btn-sm" data-open-modal="rfpModal" style="margin-top: 16px;" type="button">Request Powered Shell Matrix</button>
          </div>
          <div class="sol-visual-col">
            <div class="sol-matrix-card">
              <h4>Standard Powered Shell Scope</h4>
              <div class="scope-item"><strong>HV Substation:</strong> 230kV/110kV dedicated GIS switchyard</div>
              <div class="scope-item"><strong>Structural Envelope:</strong> Seismic Zone III reinforced concrete</div>
              <div class="scope-item"><strong>Clear Height:</strong> 6.0m to 8.5m per data hall</div>
              <div class="scope-item"><strong>Floor Loading:</strong> 25 to 35 kN/sq.m. structural rating</div>
              <div class="scope-item"><strong>Fiber Conduits:</strong> 4 diverse carrier-neutral meet-me rooms</div>
            </div>
          </div>
        </div>

        <!-- Model 2: Turnkey BTS -->
        <div class="solution-detail-row reverse" style="margin-top: 60px;">
          <div class="sol-content-col">
            <div class="badge badge-primary">Model 02</div>
            <h2 class="sol-detail-title">Turnkey Build-to-Suit (BTS)</h2>
            <p class="sol-detail-lead">Custom-engineered campuses built to global enterprise architectural and MEP guidelines.</p>
            <p class="sol-detail-body">
              Ideal for Global Capability Centers (GCCs), semiconductor validation labs, drone/EV manufacturing gigafactories, and precision aerospace engineering facilities. GreenNext handles land aggregation, statutory clearances, detailed architecture, MEP engineering, construction, and certification.
            </p>
            <ul class="sol-feature-list">
              <li>&check; Fixed-price turnkey contract with guaranteed Commercial Operational Date (COD)</li>
              <li>&check; Custom cleanrooms (ISO 5 to ISO 8), vibration dampening &amp; heavy crane infrastructure</li>
              <li>&check; IGBC Platinum and LEED Gold environmental certification execution</li>
            </ul>
            <button class="btn btn-primary btn-sm" data-open-modal="rfpModal" style="margin-top: 16px;" type="button">Submit BTS Technical Parameters</button>
          </div>
          <div class="sol-visual-col">
            <div class="sol-matrix-card">
              <h4>Turnkey BTS Project Delivery</h4>
              <div class="scope-item"><strong>Design Phase:</strong> Concept to GFC drawings in 60 days</div>
              <div class="scope-item"><strong>Clearances:</strong> Single-window fast-track via Guidance TN</div>
              <div class="scope-item"><strong>Construction:</strong> Prefabricated precast &amp; structural steel</div>
              <div class="scope-item"><strong>Quality Assurance:</strong> Third-party global QA/QC auditing</div>
              <div class="scope-item"><strong>Commercial Terms:</strong> 15–25 year institutional leaseback</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</main>

<%- include('partials/floating-widget') %>
<%- include('partials/modal-rfp') %>
<%- include('partials/footer') %>
